# Public settings only. Restart Vite after changes; Docker reads VITE_ at startup.
VITE_APP_LOCALE=ru
VITE_BASE_PATH=/
VITE_DEV_HOST=localhost
VITE_DEV_PORT=5173
VITE_PREVIEW_HOST=localhost
VITE_PREVIEW_PORT=4173
VITE_STRICT_PORT=true
VITE_COMPANY_MAX_LENGTH=255
VITE_COMMENT_MAX_LENGTH=500
VITE_AMOUNT_INTEGER_DIGITS=17
VITE_AMOUNT_FRACTION_DIGITS=2
VITE_LEGAL_INN_DIGITS=10
VITE_SOLE_INN_DIGITS=12
VITE_FINANCING_PURPOSES=working-capital,equipment
VITE_API_BASE_URL=/api
VITE_CURRENT_USER_PATH=/users/me
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_API_PROXY_PATH=/api
VITE_API_TIMEOUT_MS=15000
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=crednexus
VITE_KEYCLOAK_CLIENT_ID=crednexus-frontend
VITE_TOKEN_MIN_VALIDITY_SECONDS=30
VITE_AUTH_TIMEOUT_MS=20000
