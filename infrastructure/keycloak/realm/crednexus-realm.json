{
  "realm": "crednexus",
  "enabled": true,
  "displayName": "CredNexus",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "rememberMe": true,
  "roles": {
    "realm": [
      {
        "name": "CLIENT",
        "description": "Entrepreneur or company representative"
      },
      {
        "name": "BANK_EMPLOYEE",
        "description": "Bank employee"
      },
      {
        "name": "ADMIN",
        "description": "Platform administrator"
      }
    ]
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@crednexus.local",
      "emailVerified": true,
      "firstName": "CredNexus",
      "lastName": "Administrator",
      "realmRoles": [
        "ADMIN"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_TEST_ADMIN_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "crednexus-frontend",
      "name": "CredNexus Frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ]
}
