# Documentation only. Real secrets live in /etc/crednexus/production.env (0600).
POSTGRES_DB=crednexus
POSTGRES_USER=crednexus
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
KEYCLOAK_DB_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_SECRET
KEYCLOAK_ADMIN_USERNAME=platform-admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_SECRET
KEYCLOAK_DEMO_ADMIN_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_SECRET
KEYCLOAK_DEMO_EMPLOYEE_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_SECRET
KEYCLOAK_DEMO_CLIENT_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_SECRET
MINIO_ROOT_USER=crednexus-storage
MINIO_ROOT_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_SECRET
MINIO_BUCKET=crednexus-documents
# Per-release images.env supplies these; all four images use the same full SHA.
IMAGE_NAMESPACE=ghcr.io/bogdanpryadko4853
IMAGE_TAG=FULL_40_CHARACTER_COMMIT_SHA
