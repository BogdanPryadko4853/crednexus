етических данных." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=0.7;align=left;verticalAlign=middle;spacingLeft=10;fontFamily=Arial;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="52" y="3759" width="1566" height="39" as="geometry" /></mxCell><mxCell id="e35" style="endArrow=block;endFill=1;edgeStyle=none;html=1;strokeColor=#25344a;strokeWidth=1.85;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="398" as="sourcePoint" /><mxPoint x="510" y="398" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v36" value="Открывает раздел «Мои заявки»" style="text;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#ffffff;fillOpacity=97;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12.3;fontColor=#25344a;" vertex="1" parent="1"><mxGeometry x="197.5" y="363" width="295" height="30" as="geometry" /></mxCell><mxCell id="e37" style="endArrow=block;endFill=1;edgeStyle=none;html=1;strokeColor=#25344a;strokeWidth=1.85;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="473" as="sourcePoint" /><mxPoint x="840" y="473" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v38" value="GET /api/applications" style="text;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#ffffff;fillOpacity=97;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12.3;fontColor=#25344a;" vertex="1" parent="1"><mxGeometry x="527.5" y="438" width="295" height="30" as="geometry" /></mxCell><mxCell id="e39" style="endArrow=block;endFill=1;edgeStyle=none;html=1;strokeColor=#25344a;strokeWidth=1.85;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="840" y="548" as="sourcePoint" /><mxPoint x="1500" y="548" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v40" value="Проверить компанию и найти её заявки" style="text;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#ffffff;fillOpacity=97;strokeColor=none;align=center;v