ит и вводит 2 млн ₽" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=#ffffff;fillOpacity=95;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12.5;fontColor=#24364b;" vertex="1" parent="1"><mxGeometry x="149.0" y="325" width="227" height="29" as="geometry" /></mxCell><mxCell id="l20" style="endArrow=block;endFill=1;html=1;strokeColor=#24364b;strokeWidth=1.9;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385" y="425" as="sourcePoint" /><mxPoint x="630" y="425" as="targetPoint" /></mxGeometry></mxCell><mxCell id="n21" value="Отправляет заявку" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=#ffffff;fillOpacity=95;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12.5;fontColor=#24364b;" vertex="1" parent="1"><mxGeometry x="394.0" y="391" width="227" height="29" as="geometry" /></mxCell><mxCell id="l22" style="endArrow=block;endFill=1;html=1;strokeColor=#24364b;strokeWidth=1.9;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="491" as="sourcePoint" /><mxPoint x="875" y="491" as="targetPoint" /></mxGeometry></mxCell><mxCell id="n23" value="Сохраняет заявку SUBMITTED" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=#ffffff;fillOpacity=95;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12.5;fontColor=#24364b;" vertex="1" parent="1"><mxGeometry x="639.0" y="457" width="227" height="29" as="geometry" /></mxCell><mxCell id="l24" style="endArrow=block;endFill=1;html=1;strokeColor=#24364b;strokeWidth=1.9;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="639" as="sourcePoint" /><mxPoint x="1120" y="639" as="targetPoint" /></mxGeometry></mxCell><mxCell id="n25" value="Проверить компанию и кредитную историю" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=#ffffff;fillOpacity=95;align=center;verticalAl