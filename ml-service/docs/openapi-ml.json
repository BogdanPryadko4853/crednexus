        "additionalProperties": false,
        "type": "object",
        "required": [
          "sector",
          "business_age_months"
        ],
        "title": "Company"
      },
      "Explanation": {
        "properties": {
          "template_version": {
            "type": "string",
            "title": "Template Version",
            "default": "ru-templates-v1"
          },
          "language": {
            "type": "string",
            "const": "ru",
            "title": "Language",
            "default": "ru"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "facts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Facts"
          },
          "next_steps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Next Steps"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          }
        },
        "type": "object",
        "required": [
          "title",
          "summary"
        ],
        "title": "Explanation"
      },
      "FinancialSnapshot": {
        "properties": {
          "month": {
            "type": "string",
            "format": "date",
            "title": "Month",
            "description": "First day of a calendar month, YYYY-MM-01"
          },
          "legal_form": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Legal Form"
          },
          "largest_customer_share": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Largest Customer Share"
          },
          "largest_channel_share": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Largest Channel Share"
          },
          "accounts_receivable": {
            "type": "number",
            "maximum": 1000000000000000.0,
            "minimum": 0.0,
