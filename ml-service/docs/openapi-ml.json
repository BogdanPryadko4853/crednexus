            "items": {
              "$ref": "#/components/schemas/MonthlyObservation"
            },
            "type": "array",
            "maxItems": 120,
            "minItems": 3,
            "title": "History"
          },
          "financial_snapshot": {
            "$ref": "#/components/schemas/FinancialSnapshot"
          },
          "bureau_history": {
            "items": {
              "$ref": "#/components/schemas/BureauMonth"
