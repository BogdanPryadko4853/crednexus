            "title": "Funding To Avoid Cash Gap"
          },
          "funding_to_maintain_reserve": {
            "type": "number",
            "minimum": 0.0,
            "title": "Funding To Maintain Reserve"
          },
          "months": {
            "items": {
              "$ref": "#/components/schemas/CashGapMonth"
            },
            "type": "array",
            "title": "Months"
          }
