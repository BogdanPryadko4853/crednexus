            "minItems": 3,
            "title": "History"
          },
          "horizons": {
            "items": {
              "type": "integer",
              "maximum": 3.0,
              "minimum": 1.0
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "title": "Horizons",
            "default": [
              1,
              2,
              3
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "as_of_month",
          "company",
          "history"
        ],
        "title": "ForecastRequest"
      },
      "ForecastResponse": {
        "properties": {
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "feature_version": {
            "type": "string",
            "title": "Feature Version",
            "default": "monthly-v1"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "explanation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Explanation"
              },
              {
                "type": "null"
              }
            ]
          },
          "interval_nominal_coverage": {
            "type": "number",
            "exclusiveMaximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Interval Nominal Coverage"
          },
          "forecasts": {
            "items": {
              "$ref": "#/components/schemas/ForecastMonth"
            },
            "type": "array",
            "title": "Forecasts"
          }
        },
        "type": "object",
        "required": [
          "model_version",
          "warnings",
          "interval_nominal_coverage",
          "forecasts"
        ],
        "title": "ForecastResponse"
      },
      "MonthlyObservation": {
        "properties": {
