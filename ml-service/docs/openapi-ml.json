  "components": {
    "schemas": {
      "Application": {
        "properties": {
          "requested_amount": {
            "type": "number",
            "maximum": 1000000000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Requested Amount"
          },
          "term_months": {
            "type": "integer",
            "maximum": 1200.0,
            "minimum": 1.0,
            "title": "Term Months"
          },
          "annual_rate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Annual Rate"
          },
          "purpose": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Purpose"
          },
          "product_limit": {
            "type": "number",
            "maximum": 1000000000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Product Limit"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "requested_amount",
          "term_months",
          "annual_rate",
          "purpose",
          "product_limit"
        ],
        "title": "Application"
      },
      "BureauMonth": {
        "properties": {
          "month": {
            "type": "string",
            "format": "date",
            "title": "Month",
            "description": "First day of a calendar month, YYYY-MM-01"
          },
          "dpd": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Dpd"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "month",
          "dpd"
        ],
        "title": "BureauMonth"
      },
      "CashEstimate": {
        "properties": {
          "lower": {
            "type": "number",
            "title": "Lower"
          },
          "prediction": {
            "type": "number",
            "title": "Prediction"
          },
          "upper": {
            "type": "number",
            "title": "Upper"
          }
        },
        "type": "object",
        "required": [
          "lower",
          "prediction",
          "upper"
        ],
        "title": "CashEstimate"
      },
      "CashGapMonth": {
        "properties": {
          "horizon": {
            "type": "integer",
            "title": "Horizon"
          },
          "month": {
            "type": "string",
            "format": "date",
            "title": "Month"
          },
          "opening_balance": {
            "type": "number",
            "title": "Opening Balance"
          },
          "cash_inflow": {
            "type": "number",
            "minimum": 0.0,
            "title": "Cash Inflow"
          },
          "operating_cash_outflow": {
            "type": "number",
            "minimum": 0.0,
            "title": "Operating Cash Outflow"
          },
          "non_operating_inflow": {
            "type": "number",
            "minimum": 0.0,
            "title": "Non Operating Inflow"
          },
          "non_operating_outflow": {
            "type": "number",
            "minimum": 0.0,
            "title": "Non Operating Outflow"
          },
          "net_cash_flow": {
            "type": "number",
            "title": "Net Cash Flow"
          },
          "closing_balance": {
            "type": "number",
            "title": "Closing Balance"
          },
          "cash_shortfall": {
            "type": "number",
            "minimum": 0.0,
            "title": "Cash Shortfall"
          },
          "reserve_shortfall": {
            "type": "number",
            "minimum": 0.0,
            "title": "Reserve Shortfall"
          }
        },
        "type": "object",
        "required": [
          "horizon",
          "month",
          "opening_balance",
          "cash_inflow",
          "operating_cash_outflow",
          "non_operating_inflow",
          "non_operating_outflow",
          "net_cash_flow",
          "closing_balance",
          "cash_shortfall",
          "reserve_shortfall"
        ],
        "title": "CashGapMonth"
      },
      "CashGapRequest": {
        "properties": {
          "as_of_month": {
            "type": "string",
            "format": "date",
            "title": "As Of Month",
            "description": "Last closed month, YYYY-MM-01"
          },
          "company": {
            "$ref": "#/components/schemas/Company"
          },
          "history": {
