          "investments",
          "financing_inflow",
          "other_inflow",
          "other_outflow"
        ],
        "title": "PlannedCashMovements",
        "description": "Known non-operating cash movements; explicit zeros mean no planned movement."
      },
      "ScoreRequest": {
        "properties": {
          "as_of_month": {
            "type": "string",
            "format": "date",
            "title": "As Of Month",
            "description": "Last closed month, YYYY-MM-01"
          },
          "company": {
            "$ref": "#/components/schemas/Company"
          },
