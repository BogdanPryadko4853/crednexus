            "description": "First day of a calendar month, YYYY-MM-01"
          },
          "sales": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000000000000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Sales"
          },
          "cash_inflow": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000000000000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Cash Inflow"
          },
          "operating_cash_outflow": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000000000000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Operating Cash Outflow"
          },
          "cash_balance": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000000000000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Cash Balance"
          },
          "operating_expense": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000000000000.0,
                "minimum": 0.0
              },
