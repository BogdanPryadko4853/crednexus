        "type": "object",
        "required": [
          "first_cash_gap_month",
          "first_reserve_breach_month",
          "minimum_balance",
          "funding_to_avoid_cash_gap",
          "funding_to_maintain_reserve",
          "months"
        ],
        "title": "CashGapScenario"
      },
      "Company": {
        "properties": {
          "sector": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
