            "type": "number",
            "maximum": 1000000000000000.0,
            "minimum": 0.0,
            "title": "Accounts Payable"
          },
          "overdue_payables": {
            "type": "number",
            "maximum": 1000000000000000.0,
            "minimum": 0.0,
            "title": "Overdue Payables"
          },
          "debt_outstanding": {
            "type": "number",
            "maximum": 1000000000000000.0,
            "minimum": 0.0,
            "title": "Debt Outstanding"
          },
          "loan_arrears": {
            "type": "number",
            "maximum": 1000000000000000.0,
            "minimum": 0.0,
            "title": "Loan Arrears"
          },
          "inventory": {
            "type": "number",
            "maximum": 1000000000000000.0,
            "minimum": 0.0,
            "title": "Inventory"
          },
          "business_state": {
            "type": "string",
            "enum": [
              "active",
              "distressed",
              "restructuring"
            ],
            "title": "Business State"
          },
          "existing_monthly_debt_service": {
            "type": "number",
            "maximum": 1000000000000000.0,
            "minimum": 0.0,
            "title": "Existing Monthly Debt Service"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "month",
          "legal_form",
          "largest_customer_share",
          "largest_channel_share",
          "accounts_receivable",
          "accounts_payable",
          "overdue_payables",
          "debt_outstanding",
          "loan_arrears",
          "inventory",
          "business_state",
          "existing_monthly_debt_service"
        ],
        "title": "FinancialSnapshot"
      },
      "ForecastMonth": {
        "properties": {
          "horizon": {
            "type": "integer",
            "title": "Horizon"
          },
          "target_month": {
            "type": "string",
            "title": "Target Month"
          },
          "cash_inflow": {
            "$ref": "#/components/schemas/CashEstimate"
          },
          "operating_cash_outflow": {
            "$ref": "#/components/schemas/CashEstimate"
          },
          "operating_net_cash_flow": {
            "type": "number",
            "title": "Operating Net Cash Flow"
          },
          "explanation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Explanation"
              },
              {
                "type": "null"
              }
