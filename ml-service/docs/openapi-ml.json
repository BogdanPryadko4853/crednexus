            "type": "array",
            "maxItems": 120,
            "minItems": 3,
            "title": "History"
          },
          "months": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 1.0,
            "title": "Months",
            "default": 3
          },
          "minimum_cash_reserve": {
            "type": "number",
            "maximum": 1000000000000000.0,
            "minimum": 0.0,
            "title": "Minimum Cash Reserve",
            "default": 0.0
          },
          "cash_plan": {
            "items": {
              "$ref": "#/components/schemas/PlannedCashMovements"
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "title": "Cash Plan"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "as_of_month",
          "company",
          "history",
          "cash_plan"
        ],
        "title": "CashGapRequest"
      },
      "CashGapResponse": {
        "properties": {
          "calculation_version": {
            "type": "string",
            "title": "Calculation Version",
            "default": "cash-gap-v1"
          },
          "as_of_month": {
            "type": "string",
            "format": "date",
            "title": "As Of Month"
          },
          "opening_balance": {
            "type": "number",
            "minimum": 0.0,
            "title": "Opening Balance"
          },
          "minimum_cash_reserve": {
            "type": "number",
            "minimum": 0.0,
            "title": "Minimum Cash Reserve"
          },
          "base": {
            "$ref": "#/components/schemas/CashGapScenario"
          },
          "adverse": {
            "$ref": "#/components/schemas/CashGapScenario"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "feature_version": {
            "type": "string",
            "title": "Feature Version",
            "default": "monthly-v1"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "explanation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Explanation"
              },
              {
                "type": "null"
              }
            ]
          },
          "cash_plan": {
            "items": {
              "$ref": "#/components/schemas/PlannedCashMovements"
            },
            "type": "array",
            "title": "Cash Plan"
